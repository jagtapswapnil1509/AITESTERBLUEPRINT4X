@REM Apache Maven Wrapper startup script for Windows NT
@REM generated by maven-wrapper.java, version 3.3.2

@if "%DEBUG%"=="" @echo off
@if exist "%USERPROFILE%\mavenrc_pre.bat" call "%USERPROFILE%\mavenrc_pre.bat"
@if exist "%USERPROFILE%\mavenrc_pre.cmd" call "%USERPROFILE%\mavenrc_pre.cmd"

set "MAVEN_OPTS=-Xmx512m"

set "WRAPPER_JAR=%MAVEN_PROJECTBASEDIR%\.mvn\wrapper\maven-wrapper.jar"
set "WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain"

set "MAVEN_PROJECTBASEDIR=%CD%"
if not "%MVNW_VERBOSE%"=="" @echo Using MAVEN_PROJECTBASEDIR: %MAVEN_PROJECTBASEDIR%

@REM find MAVEN_HOME using location of mvnw.cmd
if exist "%MAVEN_PROJECTBASEDIR%\mvnw.cmd" set "MAVEN_HOME=%MAVEN_PROJECTBASEDIR%"

if exist "%MAVEN_HOME%\bin\mvn.cmd" (
  set "MAVEN_CMD=%MAVEN_HOME%\bin\mvn.cmd"
  set "MVN_CMD_EXISTS=true"
) else (
  set "MAVEN_CMD=mvn"
  set "MVN_CMD_EXISTS=false"
)

if not "%MVNW_REPOURL%"=="" (
  set "MVNW_REPOURL=%MVNW_REPOURL%"
) else (
  set "MVNW_REPOURL=https://repo.maven.apache.org/maven2"
)

if not "%MVNW_VERBOSE%"=="" @echo Using WRAPPER_JAR: %WRAPPER_JAR%
if not "%MVNW_VERBOSE%"=="" @echo Using MVNW_REPOURL: %MVNW_REPOURL%

if exist "%WRAPPER_JAR%" (
    if "%MVNW_VERBOSE%"=="true" @echo Found wrapper jar: %WRAPPER_JAR%
) else (
    if not "%MVNW_REPOURL%"=="" (
      if "%MVNW_VERBOSE%"=="true" @echo Downloading wrapper jar...
      powershell -Command "& { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; Invoke-WebRequest -Uri '%MVNW_REPOURL%/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar' -OutFile '%WRAPPER_JAR%' -UseBasicParsing }"
    )
    if errorlevel 1 (
      @echo Failed to download wrapper jar
      exit /b 1
    )
)

@REM Resolve classpath elements into a classpath string using semi-colons.
set "CLASSWORLDS_JAR=%MAVEN_PROJECTBASEDIR%\.mvn\wrapper\maven-wrapper.jar"
set "CLASSWORLDS_LAUNCHER=org.codehaus.plexus.classworlds.launcher.Launcher"

"%JAVA_HOME%\bin\java.exe" ^
  %MAVEN_OPTS% ^
  -classpath "%CLASSWORLDS_JAR%" ^
  "-Dclassworlds.conf=%MAVEN_PROJECTBASEDIR%\.mvn\wrapper\maven-wrapper.properties" ^
  "-Dmaven.home=%MAVEN_HOME%" ^
  "-Dlibrary.jansi.path=%MAVEN_HOME%\lib\jansi-native" ^
  "-Dmaven.multiModuleProjectDirectory=%MAVEN_PROJECTBASEDIR%" ^
  %WRAPPER_LAUNCHER% %MAVEN_CONFIG% %*
if errorlevel 1 exit /b 1
exit /b 0
